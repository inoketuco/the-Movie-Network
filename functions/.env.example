# Copy to functions/.env (plain config, not secrets). See WHOP_SETUP.md.
# The API key and webhook secret are NOT set here: use
#   npx.cmd firebase-tools functions:secrets:set WHOP_API_KEY
#   npx.cmd firebase-tools functions:secrets:set WHOP_WEBHOOK_SECRET
# Your SANDBOX company id from sandbox.whop.com while testing.
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
# Optional: the Whop product that checkout plans are attached to.
WHOP_PRODUCT_ID=
# Whop's sandbox: test payments, fake money. Change to https://api.whop.com/api/v1 only when going live.
WHOP_API_BASE=https://sandbox-api.whop.com/api/v1
