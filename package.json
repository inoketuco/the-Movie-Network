{
  "name": "the-movie-network",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:coverage": "jest --coverage --collectCoverageFrom=*.js --collectCoverageFrom=!*.config.js --collectCoverageFrom=!jest.setup.js --collectCoverageFrom=!index.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "^57.0.25",
    "expo-auth-session": "~57.0.15",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-location": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/functions/",
      "<rootDir>/dist"
    ],
    "testTimeout": 20000
  }
